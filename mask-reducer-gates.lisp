(in-package #:trivial-simd)

;; Columns: selection, arithmetic, spill; each has pointer, copy, view gates.
(defparameter *native-mask-reducer-gates*
  (let ((table (make-hash-table :test #'equal)))
    (when (equal *native-mask-reducer-architecture* "ARM64")
      (dolist (entry
               '((:f32 sum 256 256 256 256 256 256 1024 1024 1024)
                 (:f32 asum 256 256 256 256 256 256 nil nil nil)
                 (:f32 nrm2 256 256 256 256 256 256 nil nil nil)
                 (:f32 minimum 256 1024 1024 1024 4096 1024 1024 1024 1024)
                 (:f32 maximum 256 1024 1024 1024 4096 1024 nil nil nil)
                 (:f32 argmin 256 1024 1024 1024 1024 1024 nil nil nil)
                 (:f32 argmax 256 1024 1024 1024 1024 1024 nil nil nil)
                 (:f32 prod 256 256 256 256 256 256 nil nil nil)
                 (:f64 sum 256 256 256 256 256 256 nil nil nil)
                 (:f64 asum 256 256 256 256 256 256 nil nil nil)
                 (:f64 nrm2 256 256 256 256 256 256 nil nil nil)
                 (:f64 minimum 256 256 256 256 256 256 nil nil nil)
                 (:f64 maximum 256 256 256 256 256 256 nil nil nil)
                 (:f64 argmin 256 1024 256 256 1024 1024 nil nil nil)
                 (:f64 argmax 256 1024 256 256 1024 1024 nil nil nil)
                 (:f64 prod 256 256 256 256 256 256 nil nil nil)
                 (:s8 sum 256 256 256 256 256 256 nil nil nil)
                 (:s8 asum 256 256 256 256 256 256 nil nil nil)
                 (:s8 minimum 1024 nil 1024 nil nil nil nil nil nil)
                 (:s8 maximum 1024 1024 1024 nil nil nil nil nil nil)
                 (:s8 argmin 1024 nil 1024 nil nil nil nil nil nil)
                 (:s8 argmax 1024 4096 1024 nil nil nil nil nil nil)
                 (:s8 prod 256 256 256 256 256 256 nil nil nil)
                 (:u8 sum 256 256 256 256 256 256 nil nil nil)
                 (:u8 asum 256 256 256 256 256 256 nil nil nil)
                 (:u8 minimum 1024 1024 1024 nil nil nil nil nil nil)
                 (:u8 maximum 1024 1024 1024 nil nil nil nil nil nil)
                 (:u8 argmin 1024 4096 1024 nil nil nil nil nil nil)
                 (:u8 argmax 1024 4096 1024 nil nil nil nil nil nil)
                 (:u8 prod 256 256 256 256 256 256 nil nil nil)
                 (:s16 sum 256 256 256 256 256 256 nil nil nil)
                 (:s16 asum 256 256 256 256 256 256 nil nil nil)
                 (:s16 minimum 1024 nil 1024 nil nil nil nil nil nil)
                 (:s16 maximum 1024 4096 1024 nil nil nil nil nil nil)
                 (:s16 argmin 1024 nil 1024 nil nil nil nil nil nil)
                 (:s16 argmax 1024 4096 1024 nil nil nil nil nil nil)
                 (:s16 prod 256 256 256 256 256 256 nil nil nil)
                 (:u16 sum 256 256 256 256 256 256 nil nil nil)
                 (:u16 asum 256 256 256 256 256 256 nil nil nil)
                 (:u16 minimum 1024 1024 1024 65536 nil 65536 nil nil nil)
                 (:u16 maximum 1024 1024 1024 nil nil nil nil nil nil)
                 (:u16 argmin 1024 1024 1024 nil nil nil nil nil nil)
                 (:u16 argmax 1024 1024 1024 nil nil nil nil nil nil)
                 (:u16 prod 256 256 256 256 256 256 nil nil nil)
                 (:s32 sum 256 256 256 256 256 256 nil nil nil)
                 (:s32 asum 256 256 256 256 256 256 nil nil nil)
                 (:s32 minimum 1024 nil 1024 nil nil nil nil nil nil)
                 (:s32 maximum 1024 65536 1024 nil nil nil nil nil nil)
                 (:s32 argmin 1024 nil 1024 nil nil nil nil nil nil)
                 (:s32 argmax 1024 nil 1024 nil nil nil nil nil nil)
                 (:s32 prod 256 256 256 256 256 256 nil nil nil)
                 (:u32 sum 256 256 256 256 256 256 nil nil nil)
                 (:u32 asum 256 256 256 256 256 256 nil nil nil)
                 (:u32 minimum 1024 4096 1024 16384 nil nil nil nil nil)
                 (:u32 maximum 1024 4096 1024 nil nil nil nil nil nil)
                 (:u32 argmin 1024 4096 1024 nil nil nil nil nil nil)
                 (:u32 argmax 1024 4096 1024 nil nil nil nil nil nil)
                 (:u32 prod 256 256 256 256 256 256 nil nil nil)
                 (:s64 sum 256 256 256 256 256 256 nil nil nil)
                 (:s64 asum 256 256 256 256 256 256 nil nil nil)
                 (:s64 minimum 1024 nil 4096 nil nil nil nil nil nil)
                 (:s64 maximum 1024 nil 1024 nil nil nil nil nil nil)
                 (:s64 argmin 1024 nil 4096 nil nil nil nil nil nil)
                 (:s64 argmax 1024 nil 1024 nil nil nil nil nil nil)
                 (:s64 prod 256 256 256 256 256 256 nil nil nil)
                 (:u64 sum 256 256 256 256 256 256 nil nil nil)
                 (:u64 asum 256 256 256 256 256 256 nil nil nil)
                 (:u64 minimum 1024 16384 1024 nil nil nil nil nil nil)
                 (:u64 maximum 1024 16384 1024 nil nil nil nil nil nil)
                 (:u64 argmin 1024 nil 1024 nil nil nil nil nil nil)
                 (:u64 argmax 1024 nil 1024 nil nil nil nil nil nil)
                 (:u64 prod 256 256 256 256 256 256 nil nil nil)))
        (destructuring-bind (type reducer &rest gates) entry
          (loop for class in '(:selection :arithmetic :spill)
                do (dolist (access '(:pointer :copy :view))
                     (let ((gate (pop gates)))
                       (when gate
                         (setf (gethash (list "ARM64" type reducer access class) table) gate))))))))
    table))

(defparameter *native-mask-reducer-gate-floor*
  (when (plusp (hash-table-count *native-mask-reducer-gates*))
    (loop for gate being the hash-values of *native-mask-reducer-gates* minimize gate)))
