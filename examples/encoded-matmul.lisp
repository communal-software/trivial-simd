(require :asdf)
(asdf:load-system :trivial-simd)

(let* ((x (make-array 3 :element-type 'single-float :initial-contents '(1f0 2f0 3f0)))
       (values (make-array 6 :element-type 'single-float :initial-contents '(1f0 0f0 1f0 0f0 1f0 0f0)))
       (weights (make-array 6 :element-type '(unsigned-byte 16)))
       (out (make-array 2 :element-type 'single-float)))
  (trivial-simd:convert! weights values :destination-encoding :f16)
  (trivial-simd:f16-matmul! out x weights 1 2 3)
  (assert (equalp out #(4f0 2f0)))
  (cffi:with-foreign-object (raw :uint16 6)
    (dotimes (i 6) (setf (cffi:mem-aref raw :uint16 i) (aref weights i)))
    (trivial-simd:f16-matmul! out x (trivial-simd:make-vector-view raw :u16 6) 1 2 3)
    (assert (equalp out #(4f0 2f0))))
  (format t "~&~S~%" out))
