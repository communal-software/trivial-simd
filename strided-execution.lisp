(in-package #:trivial-simd)

(defun direct-strided-p (strides)
  (and (eq *backend* :native) (some (lambda (stride) (and stride (/= stride 1))) strides)))

(defun strided-reader (value offset stride)
  (if (operand-vector-p value)
      (let ((offset (or offset 0)) (stride (or stride 1)))
        (lambda (i) (vector-ref value (+ offset (* i stride)))))
      (lambda (i) (declare (ignore i)) value)))

(defun strided-arithmetic (operation type)
  (if (integer-type-p type)
      (symbol-function (integer-operation-symbol operation type))
      (ecase operation (:add #'+) (:subtract #'-) (:multiply #'*) (:divide #'/))))

(defun strided-bulk-lisp (operation destination operands count offsets strides
                         operator rounding destination-encoding input-encoding)
  (let* ((type (vector-type destination))
         (a (strided-reader (first operands) (second offsets) (second strides)))
         (b (strided-reader (second operands) (third offsets) (third strides)))
         (c (strided-reader (third operands) (fourth offsets) (fourth strides)))
         (d-offset (first offsets)) (d-stride (or (first strides) 1))
         (binary (when (member operation '(:add :subtract :multiply :divide))
                   (strided-arithmetic operation type)))
         (multiply (strided-arithmetic :multiply type))
         (add (strided-arithmetic :add type)))
    (declare (dynamic-extent a b c))
    (dotimes (i count)
      (let* ((x (funcall a i))
             (index (+ d-offset (* i d-stride)))
             (value
               (case operation
                 ((:add :subtract :multiply :divide) (funcall binary x (funcall b i)))
                 (:scale (funcall multiply (vector-ref destination index) x))
                 (:axpy (funcall add (funcall multiply x (funcall b i)) (vector-ref destination index)))
                 (:fma (fma x (funcall b i) (funcall c i)))
                 (:negate (if (integer-type-p type) (wrapped-unary :negate type x) (- x)))
                 (:abs (if (integer-type-p type) (wrapped-unary :abs type x) (abs x)))
                 (:sqrt (kernel-sqrt x))
                 (:reciprocal (/ (coerce 1 (second (numeric-type type))) x))
                 (:min (kernel-min-left x (funcall b i)))
                 (:max (kernel-max-left x (funcall b i)))
                 (:clamp (let ((low (funcall b i)) (high (funcall c i)))
                           (when (> low high) (error "CLAMP! lower bound exceeds upper bound"))
                           (if (< x low) low (if (> x high) high x))))
                 (:compare (if (compare-values operator x (funcall b i)) 1 0))
                 (:select (if (zerop x) (funcall c i) (funcall b i)))
                 (:convert (nd-convert-value x type (vector-type (first operands)) rounding
                                             destination-encoding input-encoding))
                 ((:copy :fill) x)
                 (:swap (prog1 x (setf (vector-ref (first operands)
                                                 (+ (second offsets) (* i (or (second strides) 1))))
                                      (vector-ref destination index))))
                 (otherwise (error "Unknown strided operation ~S" operation)))))
        (setf (vector-ref destination index) value))))
  destination)

(defun strided-bulk (operation destination operands count offsets strides
                     &key operator (rounding :nearest-even) destination-encoding input-encoding)
  (when (zerop count) (return-from strided-bulk destination))
  (let ((operands (copy-list operands)) (offsets (copy-list offsets))
        (strides (if (= count 1) (mapcar (lambda (stride) (and stride 1)) strides) (copy-list strides))))
    (unless (eq operation :swap)
      (loop for tail on operands for offset-tail on (rest offsets) for stride-tail on (rest strides)
            do (multiple-value-bind (input offset stride)
                   (unshifted-bulk-input destination (first offsets) (first strides)
                                         (car tail) (car offset-tail) (car stride-tail) count)
                 (setf (car tail) input (car offset-tail) offset (car stride-tail) stride))))
    (if (strided-native-bulk-p operation destination operands destination-encoding input-encoding rounding)
        (strided-bulk-native operation destination operands count offsets strides operator rounding
                             destination-encoding input-encoding)
        (let ((convert (when (eq operation :convert)
                         (strided-lisp-convert-function destination (first operands) destination-encoding input-encoding))))
          (cond (convert (funcall convert destination (first operands) count offsets strides rounding))
                ((strided-lisp-bulk-p operation destination operands)
                 (strided-bulk-arrays operation destination operands count offsets strides operator))
                (t (strided-bulk-lisp operation destination operands count offsets strides operator rounding
                                      destination-encoding input-encoding)))))))

(defun strided-reduce-lisp (operation inputs count offsets strides wide)
  (let* ((type (vector-type (first inputs)))
         (a (strided-reader (first inputs) (first offsets) (first strides)))
         (b (strided-reader (second inputs) (second offsets) (second strides)))
         (add (strided-arithmetic :add type)) (multiply (strided-arithmetic :multiply type))
         (zero (if (complex-type-p type) (if (eq operation :asum)
                                                 (if (or wide (eq type :c64)) 0d0 0f0)
                                                 (if wide #C(0d0 0d0) (complex-zero type)))
                   (if wide 0d0 (coerce 0 (second (numeric-type type)))))))
    (declare (dynamic-extent a b))
    (when (eq operation :nrm2)
      (let ((norm (if (member type '(:f32 :c32))
                      (let ((sum 0d0))
                        (dotimes (i count (sqrt sum))
                          (let* ((value (funcall a i))
                                 (real (coerce (realpart value) 'double-float))
                                 (imaginary (coerce (imagpart value) 'double-float)))
                            (incf sum (+ (* real real) (* imaginary imaginary))))))
                      (scaled-norm-function count a))))
        (return-from strided-reduce-lisp
          (if (and (member type '(:f32 :c32)) (not wide)) (coerce norm 'single-float) norm))))
    (when (member operation '(:argmin :argmax :iamax))
      (unless (zerop count)
        (let* ((best (funcall a 0)) (index 0))
          (when (eq operation :iamax) (setf best (abs best)))
          (loop for i from 1 below count for value = (funcall a i) do
            (when (eq operation :iamax) (setf value (abs value)))
            (when (if (eq operation :argmin) (< value best) (> value best))
              (setf best value index i)))
          (return-from strided-reduce-lisp
            (+ (first offsets) (* index (or (first strides) 1))))))
      (return-from strided-reduce-lisp nil))
    (let ((result (case operation
                    (:prod (if (complex-type-p type)
                               (complex (coerce 1 (if (eq type :c32) 'single-float 'double-float))
                                        (coerce 0 (if (eq type :c32) 'single-float 'double-float)))
                               (coerce 1 (second (numeric-type type)))))
                    (:count 0) (:any nil) (:all t) (otherwise zero))))
      (dotimes (i count result)
        (let ((x (funcall a i)))
          (when wide (setf x (if (complexp x) (widen-complex x) (coerce x 'double-float))))
          (setf result
                (ecase operation
                  (:sum (funcall add result x))
                  (:prod (funcall multiply result x))
                  ((:dot :dotc)
                   (let ((y (funcall b i)))
                     (when wide (setf y (if (complexp y) (widen-complex y) (coerce y 'double-float))))
                     (funcall add result (funcall multiply (if (eq operation :dotc) (conjugate x) x) y))))
                  (:asum (funcall add result (if (integer-type-p type) (wrapped-unary :abs type x) (abs x))))
                  (:count (+ result (if (zerop x) 0 1)))
                  (:any (or result (not (zerop x))))
                  (:all (and result (not (zerop x)))))))))))

(defun strided-reduce (operation inputs count offsets strides &optional wide)
  (when (<= count 1) (setf strides (mapcar (lambda (stride) (and stride 1)) strides)))
  (if (strided-native-reduce-p operation inputs)
      (strided-reduce-native operation inputs count offsets strides wide)
      (let ((function (strided-lisp-reduce-function operation inputs wide)))
        (if function (funcall function (first inputs) (second inputs) count offsets strides)
            (strided-reduce-lisp operation inputs count offsets strides wide)))))

(defparameter *strided-operations*
  '(:add :subtract :multiply :divide :negate :abs :sqrt :reciprocal
    :min :max :clamp :compare :select :convert :scale :axpy :fma :copy :fill :swap))
(defparameter *strided-reductions*
  '(:sum :dot :dotc :asum :prod :argmin :argmax :iamax :nrm2 :count :any :all))
(defparameter *strided-types* (append (mapcar #'first *numeric-types*) '(:c32 :c64)))

(define-native ("ts_strided_execute" %native-strided-execute) :int
  (operation :uint) (type :uint) (destination-type :uint) (input-type :uint)
  (comparison :uint) (rounding :int) (count :size) (strides :pointer) (pointers :pointer))
(define-native ("ts_strided_reduce" %native-strided-reduce) :int
  (operation :uint) (type :uint) (count :size) (left :pointer) (right :pointer)
  (left-stride :int64) (right-stride :int64) (wide :int)
  (result :pointer) (wide-result :pointer) (index :pointer))

(define-native ("ts_strided_mask_reduce" %native-strided-mask-reduce) :uint64
  (operation :uint) (input :pointer) (count :size) (stride :int64))

(defvar *native-strided-available-p*
  (and *native-available-p*
       (null (missing-native-symbols '("ts_strided_execute" "ts_strided_reduce" "ts_strided_mask_reduce")))))

(defun strided-native-storage-p (values)
  (and *native-strided-available-p*
       (every (lambda (value)
                (or (not (operand-vector-p value)) (vector-view-p value)
                    (and (eq *native-array-access* :pointer)
                         (or (not (complex-type-p (vector-type value)))
                             #+sbcl t #-sbcl nil))))
              values)))

(defun strided-type-code (value &optional encoding)
  (if encoding (ecase encoding (:bf16 12) (:f16 13))
      (position (vector-type value) *strided-types*)))

(defun strided-native-bulk-p (operation destination operands d-encoding i-encoding rounding)
  (and (strided-native-storage-p (cons destination operands))
       (if (eq operation :convert)
           (and (not (complex-type-p (vector-type destination)))
                (not (complex-type-p (vector-type (first operands))))
                (if (or d-encoding i-encoding)
                    (native-encoded-conversion-p t rounding t)
                    (or (and (member (vector-type destination) '(:f32 :f64))
                             (member (vector-type (first operands)) '(:f32 :f64)))
                        (and (ignore-errors (cffi:foreign-symbol-pointer "ts_extended_convert_numeric"))
                             (= 1 (%native-conversion-supported (strided-type-code destination)
                                                                (strided-type-code (first operands))))))))
           (let ((type (if (eq operation :compare)
                           (vector-type (find-if #'operand-vector-p operands))
                           (vector-type destination))))
             (and (not (and (eq operation :abs) (complex-type-p (vector-type (first operands)))))
                  (or (not (complex-type-p type))
                      (member operation '(:add :subtract :multiply :scale :axpy :copy :fill :swap))))))))

(defmacro define-strided-scalars ()
  `(defun write-strided-scalar (pointer value type)
     (ecase type
       ,@(loop for (key nil foreign) in *view-element-types*
               collect `(,key ,(view-write-form key foreign 'pointer 0 'value))))))
(define-strided-scalars)

(defun strided-with-pointers (values offsets type function &optional pointers)
  (if (null values)
      (funcall function (nreverse pointers))
      (let ((value (first values)))
        (if (operand-vector-p value)
            (with-vector-pointer (pointer value)
              (strided-with-pointers
               (rest values) (rest offsets) type function
               (cons (cffi:inc-pointer pointer (* (or (first offsets) 0)
                                                  (vector-element-size (vector-type value)))) pointers)))
            (cffi:with-foreign-object (scalar :double 2)
              (write-strided-scalar scalar value type)
              (strided-with-pointers (rest values) (rest offsets) type function (cons scalar pointers)))))))

(defun strided-bulk-native (operation destination operands count offsets strides operator rounding d-encoding i-encoding)
  (let ((type (if (member operation '(:compare :convert))
                  (vector-type (find-if #'operand-vector-p operands))
                  (vector-type destination))))
    (cffi:with-foreign-objects ((steps :int64 4) (pointers :pointer 4))
      (dotimes (i 4)
        (setf (cffi:mem-aref steps :int64 i) (or (nth i strides) 1)
              (cffi:mem-aref pointers :pointer i) (cffi:null-pointer)))
      (loop for value in operands for i from 1 unless (operand-vector-p value)
            do (setf (cffi:mem-aref steps :int64 i) 0))
      (strided-with-pointers (cons destination operands) offsets type
        (lambda (addresses)
          (loop for address in addresses for i from 0
                do (setf (cffi:mem-aref pointers :pointer i) address))
          (let ((status (%native-strided-execute
                         (position operation *strided-operations*) (position type *strided-types*)
                         (strided-type-code destination d-encoding)
                         (if (eq operation :convert) (strided-type-code (first operands) i-encoding) 0)
                         (or (position operator '(:eq :ne :lt :le :gt :ge)) 0)
                         (encoding-rounding-code rounding) count steps pointers)))
            (if (= status -3) (error 'division-by-zero) (check-native-extended-status status)))))))
  destination)

(defun strided-native-reduce-p (operation inputs)
  (and (strided-native-storage-p inputs)
       (if (complex-type-p (vector-type (first inputs)))
           (member operation '(:sum :dot :dotc :prod))
           t)))

(defun strided-reduce-native (operation inputs count offsets strides wide)
  (let* ((type (vector-type (first inputs)))
         (foreign (if (eq type :c32) :float (if (eq type :c64) :double (third (numeric-type type)))))
         (index-p (member operation '(:argmin :argmax :iamax)))
         (mask-p (member operation '(:count :any :all))))
    (when mask-p
      (with-vector-pointer (pointer (first inputs))
        (let ((value (%native-strided-mask-reduce
                      (position operation '(:count :any :all))
                      (cffi:inc-pointer pointer (first offsets)) count (or (first strides) 1))))
          (when (= value (1- (ash 1 64))) (error "Invalid native mask reduction"))
          (return-from strided-reduce-native
            (if (eq operation :count) value (not (zerop value)))))))
    (when (and index-p (zerop count)) (return-from strided-reduce-native nil))
    (cffi:with-foreign-objects ((result foreign 2) (wide-result :double 2) (index :uint64))
      (strided-with-pointers inputs offsets type
        (lambda (addresses)
          (check-native-extended-status
           (%native-strided-reduce (position operation *strided-reductions*) (position type *strided-types*)
                                   count (first addresses) (or (second addresses) (cffi:null-pointer))
                                   (or (first strides) 1) (or (second strides) 1) (if wide 1 0)
                                   result wide-result index))))
      (cond (index-p (+ (first offsets) (* (or (first strides) 1) (cffi:mem-ref index :uint64))))
            ((eq operation :nrm2)
             (if (and (eq type :f32) (not wide)) (coerce (cffi:mem-ref wide-result :double) 'single-float)
                 (cffi:mem-ref wide-result :double)))
            ((complex-type-p type)
             (let ((pointer (if wide wide-result result)) (element (if wide :double foreign)))
               (complex (cffi:mem-aref pointer element 0) (cffi:mem-aref pointer element 1))))
            (wide (cffi:mem-ref wide-result :double))
            (t (cffi:mem-ref result foreign))))))
