(in-package #:trivial-simd/tests)

(in-suite :trivial-simd)

(defun generic-blas-vector (values encoding)
  (if encoding
      (u16-vector (mapcar (lambda (value)
                           (reference-encode encoding (f32-bits (coerce value 'single-float))))
                         values))
      (blas-vector 'single-float (mapcar (lambda (value) (coerce value 'single-float)) values))))

(defun generic-blas-values (vector encoding)
  (loop for i below (simd::vector-length vector)
        for value = (simd::vector-ref vector i)
        collect (if encoding (bits-f32 (reference-decode encoding value)) value)))

(test blas-generic-families
  (dolist (backend (available-backends))
    (with-backend (backend)
      (dolist (encoding '(nil :f16 :bf16))
        (let ((x (generic-blas-vector '(99 1 88 -3 77 2 66) encoding))
              (y (generic-blas-vector '(99 4 88 5 77 6 66) encoding)))
          (is (= -1.0f0 (trivial-simd/blas:dot 3 x -2 y 2
                               :x-offset 1 :y-offset 1 :encoding encoding)))
          (is (= 6.0f0 (trivial-simd/blas:asum 3 x -2 :x-offset 1 :encoding encoding)))
          (is (typep (trivial-simd/blas:dot 3 x 2 y 2 :encoding encoding) 'single-float))
          (is (close-enough-p (trivial-simd/blas:nrm2 3 x -2 :x-offset 1 :encoding encoding)
                              (sqrt 14.0f0) 'single-float))
          (is (= 1 (trivial-simd/blas:iamax 3 x -2 :x-offset 1 :encoding encoding)))
          (is (eq y (trivial-simd/blas:axpy 3 2 x -2 y 2
                               :x-offset 1 :y-offset 1 :encoding encoding)))
          (is (equalp '(99.0f0 8.0f0 88.0f0 -1.0f0 77.0f0 8.0f0 66.0f0)
                      (generic-blas-values y encoding)))
          (is (eq x (trivial-simd/blas:scal 3 0.5d0 x -2 :x-offset 1 :encoding encoding)))
          (is (equalp '(99.0f0 0.5f0 88.0f0 -1.5f0 77.0f0 1.0f0 66.0f0)
                      (generic-blas-values x encoding)))
          (is (eq y (trivial-simd/blas:copy 3 x 2 y -2
                               :x-offset 1 :y-offset 1 :encoding encoding)))
          (multiple-value-bind (a b)
              (trivial-simd/blas:swap 3 x 2 y 2 :x-offset 1 :y-offset 1 :encoding encoding)
            (is (eq a x)) (is (eq b y)))
          (is (equalp '(99.0f0 1.0f0 88.0f0 -1.5f0 77.0f0 0.5f0 66.0f0)
                      (generic-blas-values x encoding))))))))

(test blas-generic-empty-and-errors
  (dolist (encoding '(nil :f16 :bf16))
    (let ((x (generic-blas-vector '(1 2 3) encoding))
          (y (generic-blas-vector '(4 5 6) encoding)))
      (dolist (routine '(trivial-simd/blas:asum trivial-simd/blas:nrm2 trivial-simd/blas:iamax))
        (let ((result (funcall routine 0 x -3 :x-offset 3 :encoding encoding)))
          (is (= 0 result))
          (is (typep result (if (eq routine 'trivial-simd/blas:iamax) 'integer 'single-float)))))
      (is (eql 0.0f0 (trivial-simd/blas:dot 0 x -1 y 1 :x-offset 3 :encoding encoding)))
      (is (eq y (trivial-simd/blas:axpy 0 1 x 1 y 1 :encoding encoding)))
      (is (eq x (trivial-simd/blas:scal 0 1 x 1 :encoding encoding)))
      (is (eq y (trivial-simd/blas:copy 0 x 1 y 1 :encoding encoding)))
      (multiple-value-bind (a b) (trivial-simd/blas:swap 0 x -1 y 1 :encoding encoding)
        (is (eq a x)) (is (eq b y)))
      (let ((before (copy-seq y)))
        (signals error (trivial-simd/blas:axpy 0 0 x 0 y 1 :encoding encoding))
        (signals error (trivial-simd/blas:axpy 3 0 x 2 y 1 :encoding encoding))
        (signals error (trivial-simd/blas:axpy 1 #C(1 2) x 1 y 1 :encoding encoding))
        (signals error (trivial-simd/blas:copy 2 x 1 y 2 :y-offset 1 :encoding encoding))
        (signals error (trivial-simd/blas:swap 1 x 1 y 1 :encoding :unknown))
        (signals error (trivial-simd/blas:asum -1 x 1 :encoding encoding))
        (signals error (trivial-simd/blas:nrm2 0 x 1 :x-offset 4 :encoding encoding))
        (signals error (trivial-simd/blas:iamax 1 x 1 :x-offset -1 :encoding encoding))
        (is (equalp before y)))))
  (let ((f (generic-blas-vector '(1 2) nil)) (u (u16-vector '(0 1))))
    (signals error (trivial-simd/blas:asum 0 u 1))
    (signals error (trivial-simd/blas:asum 0 f 1 :encoding :f16))
    (signals error (trivial-simd/blas:dot 1 u 1 f 1 :encoding :bf16))
    (signals error (trivial-simd/blas:scal 0 "one" f 1))
    (signals error (trivial-simd/blas:asum 0 (blas-vector 'double-float '(1d0)) 1))))

(test blas-generic-rounding
  (dolist (backend (available-backends))
    (with-backend (backend)
      (dolist (encoding '(:f16 :bf16))
        (dolist (count '(1 5 17 257))
          (let* ((bits (if (eq encoding :f16)
                           '(#x3c00 #x3c01 #x0001 #x03ff #x8001)
                           '(#x3f80 #x3f81 #x0001 #x007f #x8001)))
                 (x (u16-vector (loop for i below count collect (nth (mod i 5) bits))))
                 (y (copy-seq x))
                 (original (generic-blas-values x encoding)))
            (without-float-traps
              (trivial-simd/blas:scal count 0.5f0 x 1 :encoding encoding)
              (trivial-simd/blas:axpy count 0.5f0 y 1 y 1 :encoding encoding))
            (loop for value in original for i from 0 do
              (is (= (aref x i) (without-float-traps
                                 (reference-encode encoding (f32-bits (* value 0.5f0))))))
              (is (= (aref y i) (without-float-traps
                                 (reference-encode encoding (f32-bits (+ value (* value 0.5f0))))))))))))))

(test blas-generic-raw-copy-and-swap
  (dolist (backend (available-backends))
    (with-backend (backend)
      (dolist (encoding '(:f16 :bf16))
        (let ((x (u16-vector '(#x8000 #x7c01 #x7f81 #xffff #x0001)))
              (y (u16-vector '(1 2 3 4 5))))
          (trivial-simd/blas:copy 5 x -1 y 1 :encoding encoding)
          (is (equalp y (reverse x)))
          (trivial-simd/blas:swap 5 x 1 y 1 :encoding encoding)
          (is (equalp x (u16-vector '(#x0001 #xffff #x7f81 #x7c01 #x8000))))
          (is (equalp y (u16-vector '(#x8000 #x7c01 #x7f81 #xffff #x0001)))))
        (let ((x (u16-vector (loop for bits below 65536 collect bits)))
              (y (make-array 65536 :element-type '(unsigned-byte 16))))
          (trivial-simd/blas:copy 65536 x -1 y 1 :encoding encoding)
          (is (equalp y (reverse x)))
          (trivial-simd/blas:swap 65536 x 1 y 1 :encoding encoding)
          (is (every #'= x (loop for bits downfrom 65535 to 0 collect bits)))
          (is (every #'= y (loop for bits below 65536 collect bits))))))))

(test blas-generic-overlap
  (dolist (backend (available-backends))
    (with-backend (backend)
      (dolist (encoding '(nil :f16 :bf16))
        (let ((x (generic-blas-vector '(1 2 3 4 5) encoding)))
          (trivial-simd/blas:axpy 4 2 x -1 x 1 :y-offset 1 :encoding encoding)
          (is (equalp '(1.0f0 10.0f0 9.0f0 8.0f0 7.0f0) (generic-blas-values x encoding))))
        (dolist (offsets '((0 1) (1 0)))
          (let* ((x (generic-blas-vector '(1 2 3 4 5) encoding))
                 (expected (copy-seq x)))
            (replace expected (copy-seq x) :start1 (second offsets) :end1 (+ 4 (second offsets))
                     :start2 (first offsets) :end2 (+ 4 (first offsets)))
            (trivial-simd/blas:copy 4 x 1 x 1 :x-offset (first offsets)
                                  :y-offset (second offsets) :encoding encoding)
            (is (equalp expected x))))
        (let* ((x (generic-blas-vector '(1 2 3 4 5) encoding)) (before (copy-seq x)))
          (trivial-simd/blas:swap 5 x -1 x -1 :encoding encoding)
          (is (equalp before x))
          (signals error (trivial-simd/blas:swap 4 x 1 x 1 :y-offset 1 :encoding encoding))
          (signals error (trivial-simd/blas:swap 5 x 1 x -1 :encoding encoding))
          (is (equalp before x))
          (trivial-simd/blas:swap 2 x 2 x 2 :y-offset 1 :encoding encoding)
          (is (equalp '(2.0f0 1.0f0 4.0f0 3.0f0 5.0f0) (generic-blas-values x encoding))))))))

(test blas-generic-norm-and-reductions
  (dolist (backend (available-backends))
    (with-backend (backend)
      (dolist (encoding '(nil :f16 :bf16))
        (let ((x (generic-blas-vector '(3 -3 1) encoding)))
          (is (= 0 (trivial-simd/blas:iamax 3 x 1 :encoding encoding)))
          (is (= 1 (trivial-simd/blas:iamax 3 x -1 :encoding encoding)))
          (is (typep (trivial-simd/blas:asum 3 x 1 :encoding encoding) 'single-float))
          (is (typep (trivial-simd/blas:nrm2 3 x 1 :encoding encoding) 'single-float))))
      (let ((x (generic-blas-vector '(65504 65504) :f16)))
        (is (= 131008.0f0 (trivial-simd/blas:asum 2 x 1 :encoding :f16)))
        (is (> (trivial-simd/blas:nrm2 2 x 1 :encoding :f16) 65504.0f0)))
      (dolist (encoding '(nil :bf16))
        (dolist (value '(1.0e30 1.0e-30))
          (let* ((x (generic-blas-vector (list value value) encoding))
                 (stored (first (generic-blas-values x encoding)))
                 (actual (trivial-simd/blas:nrm2 2 x 1 :encoding encoding)))
            (is (< (abs (- (/ actual stored) (sqrt 2.0f0))) 1.0e-5))))
        (let ((x (generic-blas-vector '(1.0e30 1.0e-30) encoding)))
          (is (= (first (generic-blas-values x encoding))
                 (trivial-simd/blas:nrm2 2 x 1 :encoding encoding))))))))

(test blas-generic-zero-factors
  (dolist (backend (available-backends))
    (with-backend (backend)
      (dolist (encoding '(nil :f16 :bf16))
        (let* ((x (if encoding (u16-vector '(#xffff #x8000 #x7f81))
                     (without-float-traps
                       (blas-vector 'single-float (list (bits-f32 #x7fc00000) -0.0f0
                                                       (bits-f32 #x7f800000))))))
               (y (copy-seq x)) (before (copy-seq y)))
          (trivial-simd/blas:axpy 3 0 x 1 y 1 :encoding encoding)
          (dotimes (i 3)
            (is (= (if encoding (aref before i) (f32-bits (aref before i)))
                   (if encoding (aref y i) (f32-bits (aref y i))))))
          (trivial-simd/blas:scal 2 -0.0f0 x -2 :encoding encoding)
          (dolist (i '(0 2))
            (is (= 0 (if encoding (aref x i) (f32-bits (aref x i)))))))))))

(test blas-generic-views-and-fallback
  (dolist (backend (available-backends))
    (with-backend (backend)
      (dolist (encoding '(nil :f16 :bf16))
        (let* ((source (generic-blas-vector '(1 2 3 4 5) encoding))
               (foreign (if encoding :uint16 :float))
               (type (if encoding :u16 :f32)))
          (cffi:with-foreign-object (pointer foreign 6)
            (dotimes (i 5) (setf (cffi:mem-aref pointer foreign i) (aref source i)))
            (let ((x (simd:make-vector-view pointer type 5))
                  (y (simd:make-vector-view pointer type 5 :offset 1)))
              (trivial-simd/blas:axpy 4 2 x -1 y 1 :encoding encoding)
              (is (equalp '(1.0f0 10.0f0 9.0f0 8.0f0 7.0f0) (generic-blas-values x encoding)))
              (let ((before (generic-blas-values x encoding)))
                (signals error (trivial-simd/blas:swap 4 x 1 y 1 :encoding encoding))
                (is (equalp before (generic-blas-values x encoding))))
              (trivial-simd/blas:copy 4 x 1 source -1 :encoding encoding)
              (is (equalp '(8.0f0 9.0f0 10.0f0 1.0f0 5.0f0) (generic-blas-values source encoding)))
              (is (= 28.0f0 (trivial-simd/blas:asum 4 x 1 :encoding encoding)))
              (is (= 1 (trivial-simd/blas:iamax 4 x 1 :encoding encoding)))
              (is (= 10.0f0 (trivial-simd/blas:nrm2 1 x 1 :x-offset 1 :encoding encoding)))
              (is (= 100.0f0 (trivial-simd/blas:dot 1 x 1 x 1 :x-offset 1 :y-offset 1 :encoding encoding)))
              (trivial-simd/blas:scal 1 0 x 1 :x-offset 1 :encoding encoding)
              (is (= 0 (simd::vector-ref x 1)))))))))
  (let ((simd::*native-available-p* nil)
        (simd::*native-float-encoding-available-p* nil)
        (simd::*native-encoded-conversion-rounding-modes* 0))
    (with-backend (:lisp)
      (dolist (encoding '(:f16 :bf16))
        (let ((x (generic-blas-vector '(1 2 3) encoding)))
          (trivial-simd/blas:scal 3 2 x 1 :encoding encoding)
          (is (= 12.0f0 (trivial-simd/blas:asum 3 x 1 :encoding encoding))))))))
