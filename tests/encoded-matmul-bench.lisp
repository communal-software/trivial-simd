(require :asdf)
(unless (find-package :ql)
  (let ((setup (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
    (when (probe-file setup) (load setup))))
(let ((root (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*))))
  (asdf:initialize-source-registry
   `(:source-registry (:directory ,root) :inherit-configuration)))
(asdf:load-system :trivial-simd/blas)
(load (merge-pathnames "benchmark-timing.lisp" *load-truename*))

(defun encoded-measure (label function)
  (let ((time (benchmark-time function)))
    #+sbcl (sb-ext:gc :full t)
    (let ((before #+sbcl (sb-ext:get-bytes-consed) #-sbcl 0))
      (dotimes (i 32) (funcall function))
      (format t "~&~A: ~,3F ms; Lisp bytes ~A~%" label (/ time 1000)
              #+sbcl (/ (- (sb-ext:get-bytes-consed) before) 32d0) #-sbcl :unavailable))))

(let* ((m 8192) (k 2048) (count (* m k))
       (floats (make-array count :element-type 'single-float))
       (bits (make-array count :element-type '(unsigned-byte 16) :initial-element #x3c00))
       (trivial-simd::*backend* :native))
  (format t "~&~A ~A ~A; ~Dx~D weights~%" (lisp-implementation-type)
          (lisp-implementation-version) (machine-type) m k)
  (cffi:with-foreign-object (raw :uint16 count)
    (dotimes (i count) (setf (cffi:mem-aref raw :uint16 i) #x3c00))
    (let ((view (trivial-simd:make-vector-view raw :u16 count)))
      (dolist (shape (list (list count) (list m k)))
        (encoded-measure (format nil "nd-convert foreign ~S" shape)
                         (lambda () (trivial-simd:nd-convert! floats view shape :input-encoding :f16)))
        (assert (every (lambda (v) (= v 1f0)) floats)))
      (encoded-measure "flat convert foreign"
                       (lambda () (trivial-simd:convert! floats view :input-encoding :f16)))
      (encoded-measure "nd-convert Lisp"
                       (lambda () (trivial-simd:nd-convert! floats bits (list m k) :input-encoding :f16)))
      (dolist (encoding '(:f16 :bf16))
        (when (eq encoding :bf16)
          (dotimes (i count) (setf (cffi:mem-aref raw :uint16 i) #x3f80)))
        (dolist (n '(1 6 46))
          (let* ((x (make-array (* n k) :element-type 'single-float :initial-element 0.5f0))
                 (out (make-array (* n m) :element-type 'single-float))
                 (scratch (make-array (* 256 k) :element-type 'single-float))
                 (a (trivial-simd/blas:make-matrix-view x n k))
                 (function (if (eq encoding :f16) #'trivial-simd:f16-matmul! #'trivial-simd:bf16-matmul!))
                 (trivial-simd/blas::*native-blas-threshold* 1))
            (encoded-measure (format nil "~A native n=~D" encoding n)
                             (lambda () (funcall function out x view n m k)))
            (assert (every (lambda (v) (= v (* k 0.5f0))) out))
            (encoded-measure
             (format nil "~A convert256+BLAS n=~D" encoding n)
             (lambda ()
               (loop for row from 0 below m by 256 for rows = (min 256 (- m row)) do
                 (trivial-simd:convert! scratch view :input-start (* row k) :end (* rows k)
                                        :input-encoding encoding)
                 (trivial-simd/blas:sgemm
                  :no-transpose :transpose 1f0 a
                  (trivial-simd/blas:make-matrix-view scratch rows k) 0f0
                  (trivial-simd/blas:make-matrix-view out n rows :leading-dimension m :offset row)))))
            (assert (every (lambda (v) (= v (* k 0.5f0))) out))))))))
