(in-package #:trivial-simd/tests)
(in-suite :trivial-simd)

(simd:define-kernel shared-select-values (a b)
  (simd:select (> (+ a b) b) (+ a b) (+ (+ a b) (+ a b))))
(simd:define-kernel shared-select-count (a b)
  (simd:count (> (simd:select (> a b) (+ a b) (+ (+ a b) (+ a b))) b)))
(simd:define-kernel shared-lazy-sum (a b)
  (simd:sum (+ (+ a b)
               (simd:select (> a b) (+ (/ a b) (/ a b)) (+ (* a b) (* a b))))))
(simd:define-kernel shared-lazy-nested-sum (a b)
  (simd:sum (+ (+ a b)
               (simd:select (> a b) (+ (* a b) (* a b))
                            (simd:select (> b 0) (+ (+ a b) (+ a b)) (+ (* a b) (* a b))))
               (simd:select (> b a) (+ (* a b) (* a b)) (+ (+ a b) (+ a b))))))
(simd:define-kernel shared-fma-values (a b)
  (simd:select (> a b) (simd:fma a b (+ a b)) (+ a b)))
(simd:define-kernel shared-bit-values (mask a b)
  (simd:select (> mask 0) (simd:select (> mask 0) a b) (simd:select (> mask 0) a b)))
(simd:define-kernel shared-zero-values (mask)
  (simd:select (> mask 0) (simd:select (> mask 0) -0f0 0f0)
                        (simd:select (> mask 0) -0f0 0f0)))

(defun distinct-sharing-tree (depth &optional (index 0))
  (if (zerop depth) (list :operation :multiply (list :constant (float index 1f0))
                        '(:argument 0))
      (list :operation :add (distinct-sharing-tree (1- depth) index)
            (distinct-sharing-tree (1- depth) (+ index (ash 1 (1- depth)))))))

(test shared-mask-lowering
  (let* ((term '(:operation :add (:argument 0) (:argument 1)))
         (tree (list :operation :gt (list :operation :add term term) term)))
    (multiple-value-bind (code constants slots) (simd::lower-kernel tree :share-p t)
      (declare (ignore constants))
      (is (= 2 (count :add code :key #'first)))
      (is (= 0 slots))))
  (let ((tree (distinct-sharing-tree 8)))
    (multiple-value-bind (old constants slots) (simd::lower-kernel tree)
      (declare (ignore constants))
      (is (plusp slots))
      (is (plusp (count :spill old :key #'first)))
      (is (equal old (simd::lower-kernel tree :share-p t)))))
  (is (not (equal (simd::kernel-constant-key 0f0) (simd::kernel-constant-key -0f0))))
  (is (not (equal (simd::kernel-constant-key 1f0) (simd::kernel-constant-key 1d0))))
  (let ((tree '(:operation :add (:constant 0f0) (:constant -0f0))))
    (is (= 2 (length (nth-value 1 (simd::lower-shared-kernel
                                  (list :operation :add tree tree) nil)))))))

(test shared-mask-values-and-lazy-regions
  (let ((simd::*native-mask-reducer-minimum-count* 0))
    (dolist (entry simd::*numeric-types*)
      (let* ((key (first entry)) (element (second entry))
             (a (make-array 609 :element-type element
                                 :initial-contents (loop for i below 609 collect (coerce (+ 1 (mod i 7)) element))))
             (b (make-array 609 :element-type element
                                 :initial-contents (loop for i below 609 collect (coerce (+ 1 (mod i 5)) element))))
             (out (make-array 609 :element-type element :initial-element (coerce 0 element)))
             (expected (copy-seq out)))
        (dolist (n '(0 1 3 15 16 17 255 256 257 601))
          (let ((keys (list :end n :a-start 3 :b-start 5)))
            (with-backend (:lisp) (apply #'shared-select-values expected a b keys))
            (dolist (backend (available-backends))
              (dolist (access '(:pointer :copy))
                (let ((simd::*native-array-access* access))
                  (with-backend (backend)
                    (apply #'shared-select-values out a b keys)
                    (is (equalp expected out))
                    (dolist (function '(shared-select-count shared-lazy-sum shared-lazy-nested-sum))
                      (let ((reference (with-backend (:lisp) (apply function a b keys))))
                        (is (if (floatp reference)
                                (floats-close-p reference (apply function a b keys))
                                (eql reference (apply function a b keys))))))))))))
        (with-backend (:native)
          (with-view-memory
            (check-views 'shared-select-values (list out a b) :test #'numerically-close-p))
          (with-backend (:lisp) (shared-select-values expected a b))
          (shared-select-values a a b)
          (is (equalp expected a)))
        (when (member key '(:f32 :f64))
          (with-backend (:lisp) (shared-fma-values expected a b))
          (with-backend (:native) (shared-fma-values out a b))
          (is (equalp expected out)))))))

(test shared-lazy-errors-and-isolation
  (when simd::*native-kernel-predication-p*
    (let* ((simd::*native-mask-reducer-minimum-count* 0)
           (a (make-array 1025 :element-type 'single-float :initial-element 0f0))
           (b (make-array 1025 :element-type 'single-float :initial-element 0f0)))
      (with-backend (:native) (is (= 0f0 (shared-lazy-sum a b))))
      (setf (aref a 256) 1f0)
      (flet ((condition-type (backend)
               (with-backend (backend)
                 (handler-case (progn (shared-lazy-sum a b) nil)
                   (error (condition) (type-of condition))))))
        (is (eq (condition-type :lisp) (condition-type :native))))
      (fill b 2f0)
      (let* ((expected (with-backend (:lisp) (shared-lazy-sum a b)))
             (workers (loop repeat 4 collect
                            (bordeaux-threads:make-thread
                             (lambda ()
                               (let ((simd::*backend* :native)
                                     (simd::*native-mask-reducer-minimum-count* 0))
                                 (loop repeat 10 always (= expected (shared-lazy-sum a b)))))))))
        (dolist (worker workers) (is-true (bordeaux-threads:join-thread worker)))))))

(test shared-register-pressure
  (let* ((tree (distinct-sharing-tree 8))
         (term '(:operation :add (:argument 0) (:argument 1)))
         (branch (list :operation :add tree (list :operation :add term term)))
         (selection (list :select '(:operation :gt (:argument 0) (:argument 1)) branch branch)))
    (dolist (lazy '(nil t))
      (multiple-value-bind (code constants slots)
          (simd::lower-kernel selection :lazy-select-p lazy :share-p t)
        (declare (ignore constants))
        (is (plusp slots))
        (is (plusp (count :spill code :key #'first)))
        (is (plusp (count :reload code :key #'first)))))
    (labels ((form (node)
               (case (first node)
                 (:argument (nth (second node) '(a b)))
                 (:constant (second node))
                 (:select `(simd:select ,@(mapcar #'form (rest node))))
                 (:operation `(,(ecase (second node) (:add '+) (:multiply '*) (:gt '>))
                                ,@(mapcar #'form (cddr node)))))))
      (eval `(simd:define-kernel shared-pressure-values (a b) ,(form selection)))
      (eval `(simd:define-kernel shared-pressure-sum (a b) (simd:sum ,(form selection)))))
    (let ((simd::*native-mask-reducer-minimum-count* 0))
      (dolist (element '(single-float double-float))
        (let* ((a (make-array 257 :element-type element
                                    :initial-contents (loop for i below 257 collect (coerce (mod i 3) element))))
               (b (make-array 257 :element-type element :initial-element (coerce 1 element)))
               (out (make-array 257 :element-type element))
               (expected (copy-seq out))
               (sum (with-backend (:lisp) (shared-pressure-sum a b))))
          (with-backend (:lisp) (shared-pressure-values expected a b))
          (dolist (access '(:pointer :copy))
            (let ((simd::*native-array-access* access))
              (with-backend (:native)
                (shared-pressure-values out a b)
                (is (equalp expected out))
                (is (floats-close-p sum (shared-pressure-sum a b)))))))))))

(test shared-wrapping-and-selected-bits
  (dolist (entry simd::*numeric-types*)
    (let* ((a (conversion-boundary-input (first entry)))
           (b (reverse a)) (out (copy-seq a)) (expected (copy-seq a)))
      (with-backend (:lisp) (shared-select-values expected a b))
      (with-backend (:native) (shared-select-values out a b))
      (is (equalp expected out))))
  (dolist (entry '((single-float bits-f32 f32-bits (#x80000000 #x7fc00123 #x00000001))
                  (double-float bits-f64 f64-bits (#x8000000000000000 #x7ff8000000000123 #x1))))
    (destructuring-bind (element decode encode patterns) entry
      (let* ((mask (make-array 257 :element-type element
                                  :initial-contents (loop for i below 257 collect (coerce (mod i 2) element))))
             (a (make-array 257 :element-type element
                               :initial-contents (loop for i below 257 collect
                                                      (funcall decode (nth (mod i 3) patterns)))))
             (b (make-array 257 :element-type element :initial-element (coerce 0 element)))
             (out (copy-seq b)))
        (dolist (backend (available-backends))
          (with-backend (backend)
            (shared-bit-values out mask a b)
            (dotimes (i 257)
              (is (= (if (oddp i) (nth (mod i 3) patterns) 0) (funcall encode (aref out i))))))
          (with-backend (backend)
            (shared-zero-values out mask)
            (dotimes (i 257)
              (is (= (funcall encode (coerce (if (oddp i) -0f0 0f0) element))
                     (funcall encode (aref out i)))))))))))

(simd:define-kernel lazy-root-values (a)
  (simd:select (> a 0) (sqrt a) 0))
(simd:define-kernel lazy-nested-values (a)
  (simd:select (> a 0) (/ a (sqrt a))
               (simd:select (< a 0) (log (- a)) 0)))
(simd:define-kernel lazy-division-values (a b)
  (simd:select (/= b 0) (/ a b) a))
(simd:define-kernel lazy-declared-values (a (mask :type :s8 :repeat 3))
  (simd:select (> mask 0) (sqrt a) 0))
(simd:define-kernel lazy-declared-sum (a (mask :type :s8 :repeat 3))
  (simd:sum (simd:select (> mask 0) (sqrt a) 0)))
(simd:define-kernel lazy-normalized-values (a)
  (/ (simd:select (> a 0) (sqrt a) 0)
     (simd:sum (simd:select (> a 0) (sqrt a) 0))))
(simd:define-kernel lazy-selected-error (a b) (simd:select (> a 0) (/ a b) a))
(simd:define-kernel lazy-selected-log (a) (simd:select (< a 0) (log a) 0))
(simd:define-kernel lazy-root-mask (a)
  (> (simd:select (> a 0) (sqrt a) 0) 0))

(test lazy-selection-slices-views-and-aliases
  ;; CCL ARM64 retains sticky exceptions from earlier inline arithmetic.
  #+(and ccl arm64-target)
  (ccl::%set-fpscr-status 0)
  (dolist (element '(single-float double-float))
    (dolist (sharing '(nil t))
      (let* ((simd::*native-mask-sharing-p* sharing)
             (function (gensym "LAZY-SHARED")))
        (eval `(simd:define-kernel ,function (a)
                 (simd:select (> a 0) (+ (sqrt a) (sqrt a)) 0)))
        (dolist (pattern '((1 -1 0 4) (1 4) (-1 0)))
          (let* ((a (make-array 610 :element-type element
                               :initial-contents (loop for i below 610
                                                       collect (coerce (nth (mod i (length pattern)) pattern) element))))
                 (out (make-array 610 :element-type element :initial-element (coerce -99 element)))
                 (expected (copy-seq out)))
            (dolist (n '(0 1 3 7 255 256 257 601))
              (dolist (kernel (list #'lazy-root-values #'lazy-nested-values (symbol-function function)))
                (let ((keys (list :end n :a-start 3 :destination-start 5)))
                  (fill out (coerce -99 element))
                  (fill expected (coerce -99 element))
                  (with-backend (:lisp) (apply kernel expected a keys))
                  (dolist (backend (available-backends))
                    (dolist (access '(:pointer :copy))
                      (let ((simd::*native-array-access* access))
                        (with-backend (backend) (apply kernel out a keys))
                        (is (equalp expected out))))))))
            (with-backend (:native)
              (with-view-memory
                (check-views 'lazy-root-values (list out a) :test #'numerically-close-p)))
            (let ((copy (copy-seq a)))
              (with-backend (:lisp) (lazy-root-values expected a))
              (with-backend (:native) (lazy-root-values copy copy))
              (is (equalp expected copy)))))))))

(test lazy-selection-division-types
  (dolist (entry simd::*numeric-types*)
    (let* ((element (second entry))
           (a (make-array 601 :element-type element :initial-element (coerce 4 element)))
           (b (make-array 601 :element-type element
                               :initial-contents (loop for i below 601 collect (coerce (if (evenp i) 2 0) element))))
           (out (make-array 601 :element-type element)))
      (dolist (backend (available-backends))
        (with-backend (backend) (lazy-division-values out a b))
        (dotimes (i 601) (is (= (if (evenp i) 2 4) (aref out i))))))
    (let* ((element (second entry))
           (a (make-array 2 :element-type element :initial-element (coerce 4 element)))
           (b (make-array 2 :element-type element :initial-element (coerce 0 element)))
           (out (make-array 2 :element-type element)))
      (flet ((outcome (backend)
               (with-backend (backend)
                 (handler-case (list :value (aref (lazy-selected-error out a b) 0))
                   (error (condition) (list :error (type-of condition)))))))
        (is (equalp (outcome :lisp) (outcome :native))))
      #+(and ccl arm64-target)
      (ccl::%set-fpscr-status 0))))

(test lazy-selection-rows-passes-and-declarations
  (dolist (element '(single-float double-float))
    (let* ((a (make-array 610 :element-type element
                             :initial-contents (loop for i below 610 collect (coerce (if (evenp (floor i 3)) 4 -1) element))))
           (mask (make-array 205 :element-type '(signed-byte 8)
                                :initial-contents (loop for i below 205 collect (if (evenp i) 1 0))))
           (out (make-array 610 :element-type element :initial-element (coerce -99 element)))
           (expected (copy-seq out)))
      (dolist (n '(0 1 3 255 256 257 601))
        (dolist (kernel '(lazy-declared-values lazy-normalized-values))
          (let ((inputs (if (eq kernel 'lazy-declared-values) (list a mask) (list a))))
            (with-backend (:lisp) (apply kernel expected (append inputs (list :end n))))
            (with-backend (:native) (apply kernel out (append inputs (list :end n))))
            (is (equalp expected out))))
        (is (= (with-backend (:lisp) (lazy-declared-sum a mask :end n))
               (with-backend (:native) (lazy-declared-sum a mask :end n)))))
      (dolist (stride '(260 -260))
        (let ((start (if (minusp stride) 262 2)))
          (dolist (backend (available-backends))
            (with-backend (backend)
              (lazy-root-values out a :rows 2 :row-length 257 :a-start start :a-row-stride stride
                                     :destination-start 263 :destination-row-stride -260)
              (dotimes (row 2)
                (dotimes (i 257)
                  (is (= (sqrt (max 0 (aref a (+ start (* row stride) i))))
                         (aref out (+ 263 (* row -260) i))))))))))
      (let ((bytes (make-array 610 :element-type '(unsigned-byte 8) :initial-element 99)))
        (with-backend (:native) (lazy-root-mask bytes a))
        (dotimes (i 610) (is (= (if (plusp (aref a i)) 1 0) (aref bytes i)))))
      (with-backend (:native)
        (fill a (coerce -1 element))
        (signals error (lazy-declared-values out a mask))
        (signals error (lazy-selected-log out a))))))

(test lazy-selection-spilling
  (labels ((tree (depth index)
             (if (zerop depth) `(* a ,(1+ (mod index 251)))
                 `(+ ,(tree (1- depth) index)
                     ,(tree (1- depth) (+ index (ash 1 (1- depth))))))))
    (let ((expression `(simd:select (> a 0) (sqrt ,(tree 9 0)) 0)))
      (dolist (sharing '(nil t))
        (multiple-value-bind (code constants slots)
            (simd::lower-kernel (simd::mask-kernel-tree expression '(a)) :share-p sharing)
          (declare (ignore constants slots))
          (is (> (count :spill code :key #'first) 1)))
        (let ((simd::*native-mask-sharing-p* sharing) (kernel (gensym "LAZY-SPILL")))
          (eval `(simd:define-kernel ,kernel (a) ,expression))
          (dolist (element '(single-float double-float))
            (let* ((a (make-array 601 :element-type element
                                        :initial-contents (loop for i below 601 collect (coerce (if (evenp i) 4 -1) element))))
                   (out (make-array 601 :element-type element)) (expected (copy-seq out)))
              (with-backend (:lisp) (funcall kernel expected a))
              (with-backend (:native) (funcall kernel out a))
              (is (equalp expected out)))))))))

#+sbcl
(test lazy-selection-in-place-replay
  (simd:define-kernel lazy-underflow-values (a)
    (simd:select (> a 0) (* a 0.1) 0))
  (sb-int:with-float-traps-masked (:underflow)
    (dolist (element '(single-float double-float))
      (let* ((a (make-array 601 :element-type element :initial-element (coerce 1 element)))
             (expected (copy-seq a)))
        (setf (aref a 300) (if (eq element 'single-float)
                              least-positive-normalized-single-float
                              least-positive-normalized-double-float))
        (with-backend (:lisp) (lazy-underflow-values expected a))
        (with-backend (:native) (lazy-underflow-values a a))
        (is (equalp expected a))))))
