(in-package #:trivial-simd)

(defun kernel-constant-key (value)
  (typecase value
    (single-float (with-single-float-bits (bits from-bits)
                    (list :f32 (bits value))))
    (double-float (with-double-float-bits (bits from-bits)
                    (list :f64 (bits value))))
    (t (list (type-of value) value))))

(defun kernel-node-keys (tree)
  (let ((nodes (make-hash-table :test #'eq))
        (keys (make-hash-table :test #'equal)))
    (labels ((walk (node)
               (or (gethash node nodes)
                   (let ((key (ecase (first node)
                                (:argument node)
                                (:constant (list :constant (kernel-constant-key (second node))))
                                ((:negate :fma :select)
                                 (cons (first node) (mapcar #'walk (rest node))))
                                ((:unary :operation)
                                 (list* (first node) (second node) (mapcar #'walk (cddr node)))))))
                     (setf (gethash node nodes)
                           (or (gethash key keys)
                               (setf (gethash key keys) (hash-table-count keys))))))))
      (walk tree))
    nodes))

(defstruct shared-kernel-value
  op operands constant uses register slot)

(defun shared-kernel-ir (tree lazy-p)
  (let ((cache (make-hash-table)) (inputs (make-hash-table))
        (keys (kernel-node-keys tree))
        (needs (make-hash-table :test #'eq))
        (events nil) (values nil) (shared-p nil))
    (labels ((event (&rest parts) (push parts events))
             (value (op &optional operands constant)
               (let ((value (make-shared-kernel-value :op op :operands operands :constant constant)))
                 (push value values)
                 value))
             (boundary () (clrhash cache))
             (operands (children)
               (let ((results (make-array (length children))))
                 (dolist (index (if lazy-p (loop for i below (length children) collect i)
                                   (stable-sort (loop for i below (length children) collect i)
                                                #'> :key (lambda (i)
                                                           (register-need (nth i children) needs)))))
                   (setf (aref results index) (walk (nth index children))))
                 (coerce results 'list)))
             (walk (node)
               (when (eq (first node) :argument)
                 (return-from walk
                   (or (gethash (second node) inputs)
                       (setf (gethash (second node) inputs)
                             (value :argument nil (second node))))))
               (let* ((key (gethash node keys)) (known (gethash key cache)))
                 (when known
                   (setf shared-p t)
                   (return-from walk known))
                 (when (and lazy-p (eq (first node) :select))
                   (let ((mask (walk (second node))) (frame (gensym "BRANCH"))
                         (result (value :merge)))
                     (event :branch mask frame)
                     (boundary)
                     (event :true-store (walk (third node)) result)
                     (event :else frame)
                     (boundary)
                     (event :false-copy (walk (fourth node)) result)
                     (event :end frame result)
                     (boundary)
                     (return-from walk result)))
                 (let* ((kind (first node))
                        (op (case kind
                              ((:unary :operation) (second node))
                              (otherwise kind)))
                        (children (case kind
                                    (:constant nil)
                                    ((:unary :operation) (cddr node))
                                    (otherwise (rest node))))
                        (result (value op (operands children)
                                       (when (eq kind :constant) (second node)))))
                   (event :compute result)
                   (setf (gethash key cache) result)
                   result))))
      (event :output (walk tree)))
    (values (nreverse events) (nreverse values) shared-p)))

(defun lower-shared-kernel (tree lazy-p)
  (multiple-value-bind (events values shared-p) (shared-kernel-ir tree lazy-p)
    (unless shared-p (return-from lower-shared-kernel nil))
    (loop for event in events for position from 0
          do (dolist (value (case (first event)
                              (:compute (shared-kernel-value-operands (second event)))
                              ((:branch :true-store :false-copy :output) (list (second event)))))
               (push position (shared-kernel-value-uses value))))
    (dolist (value values)
      (setf (shared-kernel-value-uses value) (nreverse (shared-kernel-value-uses value))))
    (let ((registers (make-array +kernel-registers+ :initial-element nil))
          (code nil) (constants nil) (constant-keys nil)
          (slots 0) (free-slots nil) (free-frames nil) (frames (make-hash-table)))
      (labels ((emit (op dst a &optional (b 0)) (push (list op dst a b) code))
               (slot ()
                 (or (pop free-slots)
                     (prog1 (kernel-scratch-index slots) (incf slots))))
               (save (value)
                 (let ((register (shared-kernel-value-register value)))
                   (unless (shared-kernel-value-slot value)
                     (setf (shared-kernel-value-slot value) (slot)))
                   (emit :spill register (shared-kernel-value-slot value))
                   (setf (aref registers register) nil
                         (shared-kernel-value-register value) nil)))
               (allocate (pinned)
                 (or (position nil registers)
                     (let ((victim nil) (next -1))
                       (loop for value across registers
                             unless (member value pinned)
                               do (let ((use (or (first (shared-kernel-value-uses value))
                                                 most-positive-fixnum)))
                                    (when (> use next) (setf victim value next use))))
                       (unless victim (error "Shared kernel register allocation exhausted"))
                       (let ((register (shared-kernel-value-register victim)))
                         (save victim)
                         register))))
               (operand (value pinned)
                 (if (eq (shared-kernel-value-op value) :argument)
                     (+ +kernel-input-base+ (shared-kernel-value-constant value))
                     (or (shared-kernel-value-register value)
                         (let ((register (allocate pinned)))
                           (emit :reload register (shared-kernel-value-slot value))
                           (setf (aref registers register) value
                                 (shared-kernel-value-register value) register)
                           register))))
               (consume (value)
                 (pop (shared-kernel-value-uses value))
                 (unless (shared-kernel-value-uses value)
                   (let ((register (shared-kernel-value-register value))
                         (slot (shared-kernel-value-slot value)))
                     (when register (setf (aref registers register) nil))
                     (when slot (push slot free-slots))
                     (setf (shared-kernel-value-register value) nil
                           (shared-kernel-value-slot value) nil))))
               (flush (&optional except)
                 ;; Parent values must be saved while all parent lanes are active.
                 (loop for value across registers
                       when (and value (not (eq value except))) do (save value)))
               (constant-index (value)
                 (let* ((key (kernel-constant-key value))
                        (index (position key constant-keys :test #'equal)))
                   (or index
                       (prog1 (length constants)
                         (setf constants (append constants (list value))
                               constant-keys (append constant-keys (list key)))))))
               (compute (value position)
                 (let* ((op (shared-kernel-value-op value))
                        (args (shared-kernel-value-operands value))
                        (pinned (remove-duplicates args))
                        (operands (mapcar (lambda (arg) (operand arg pinned)) args))
                        (destructive (member op '(:fma :select)))
                        (candidate (if destructive (third args)
                                       (find-if (lambda (arg)
                                                  (and (shared-kernel-value-register arg)
                                                       (every (lambda (use) (= use position))
                                                              (shared-kernel-value-uses arg))))
                                                args)))
                        (reuse (and candidate (shared-kernel-value-register candidate)
                                    (every (lambda (use) (= use position))
                                           (shared-kernel-value-uses candidate))))
                        (destination (if reuse (shared-kernel-value-register candidate)
                                         (allocate pinned))))
                   (when destructive
                     (unless (eql destination (third operands))
                       (emit :copy destination (third operands))))
                   (emit op destination
                         (if (eq op :constant)
                             (constant-index (shared-kernel-value-constant value))
                             (first operands))
                         (or (second operands) 0))
                   (dolist (arg args) (consume arg))
                   (setf (aref registers destination) value
                         (shared-kernel-value-register value) destination))))
        (when lazy-p (emit :lazy 0 0))
        (loop for event in events for position from 0
              do (case (first event)
                   (:compute (compute (second event) position))
                   (:branch
                    (let* ((mask (second event))
                           (dead-p (every (lambda (use) (= use position))
                                          (shared-kernel-value-uses mask))))
                      (flush (when dead-p mask)))
                    (let* ((mask (second event)) (register (operand mask (list mask)))
                           (frame (or (pop free-frames)
                                      (prog1 slots
                                        (kernel-scratch-index (+ slots 1))
                                        (incf slots 2)))))
                      (setf (gethash (third event) frames) frame)
                      (emit :branch register frame)
                      (consume mask)))
                   (:true-store
                    (let* ((value (second event)) (result (third event))
                           (register (operand value (list value))))
                      (unless (shared-kernel-value-slot result)
                        (setf (shared-kernel-value-slot result) (slot)))
                      (emit :spill register (shared-kernel-value-slot result))
                      (consume value)))
                   (:false-copy
                    (let* ((value (second event)) (result (third event))
                           (source (operand value (list value)))
                           (destination
                             (if (and (shared-kernel-value-register value)
                                      (every (lambda (use) (= use position))
                                             (shared-kernel-value-uses value)))
                                 source (allocate (list value)))))
                      (unless (eql destination source) (emit :copy destination source))
                      (consume value)
                      (setf (aref registers destination) result
                            (shared-kernel-value-register result) destination)))
                   (:else (flush) (emit :else 0 (gethash (second event) frames)))
                   (:end
                    (let* ((result (third event)) (slot (shared-kernel-value-slot result))
                           (frame (gethash (second event) frames)))
                      (flush result)
                      (emit :else 1 frame)
                      (emit :reload (shared-kernel-value-register result) slot)
                      (emit :end 0 frame)
                      (setf (shared-kernel-value-slot result) nil)
                      (push slot free-slots)
                      (push frame free-frames)))
                   (:output
                    (let ((value (second event)))
                      (emit :copy +kernel-output+ (operand value (list value)))
                      (consume value)))))
        (values (nreverse code) constants slots)))))
